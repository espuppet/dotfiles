{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    //"oh-my-opencode-slim@2.2.22"
    "oh-my-opencode-slim",
     "@dietrichgebert/ponytail"
  ],
  "provider": {
    "cliproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CPA (Cliproxy)",
      "options": {
        "baseURL": "http://192.168.3.3:8317/v1",
        "apiKey": "{env:CLIPROXY_API_KEY}"
      },
      "models": {
        "gemini-3.8-flash-high": {
          "name": "Gemini 3.8 Flash High (CPA)",
          "reasoning": true,
          "limit": { "context": 1048576, "output": 65536 }
        },
        "gemini-3.1-pro-low": {
          "name": "Gemini 3.1 Pro Low (CPA)",
          "reasoning": true,
          "limit": { "context": 1048576, "output": 65536 }
        }
      }
    }
  }
}
